# Job Interview Agent Configuration
# Copy this file to .env and fill in your actual values.
# IMPORTANT: Never commit your real .env file.

# Gemini / Google AI Studio
GOOGLE_API_KEY=your_gemini_api_key_here

# Google Calendar (optional)
GOOGLE_CALENDAR_ID=your_calendar_id@gmail.com

# Interview Agent Settings
DEFAULT_INTERVIEW_DURATION=60
DEFAULT_PREPARATION_TIME=10
SESSION_TIMEOUT=3600

# Database Configuration (optional - defaults to JSON files)
# DATABASE_URL=sqlite:///interview_sessions.db
# DATABASE_TYPE=sqlite

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=interview_agent.log

# Security Settings
SECRET_KEY=your_secret_key_for_session_encryption
CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar

# Development Settings
DEBUG=false
TESTING=false

# Docker / Postgres (optional)
# POSTGRES_DB=interview_agent
# POSTGRES_USER=interview_user
# POSTGRES_PASSWORD=change_me

# Email Notifications (optional)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_USERNAME=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password
# ENABLE_EMAIL_NOTIFICATIONS=false
